# Device credentials (a single set for the lab; extend per-group as needed).
# Copy this file to .env and fill the values there. Never commit real values.
DRIFT_KEEL_USERNAME=netadmin
DRIFT_KEEL_PASSWORD=
DRIFT_KEEL_SECRET=

# Inventory and storage
DRIFT_KEEL_INVENTORY_PATH=inventory/devices.yaml
DRIFT_KEEL_CONFIG_STORE=data/configs

# Config backup git remote (a DEDICATED repo for configs, not this toolkit repo)
DRIFT_KEEL_GIT_REMOTE=
DRIFT_KEEL_GIT_BRANCH=main
DRIFT_KEEL_GIT_AUTHOR_NAME=drift-keel
DRIFT_KEEL_GIT_AUTHOR_EMAIL=drift-keel@localhost

# NetBox
DRIFT_KEEL_NETBOX_URL=
DRIFT_KEEL_NETBOX_TOKEN=

# Runtime
DRIFT_KEEL_MAX_WORKERS=8
DRIFT_KEEL_LOG_LEVEL=INFO
